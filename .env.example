# Felix — environment variables
# Copy to .env and fill in values. All variables use the FLX_ prefix
# unless noted otherwise.

# ---------------------------------------------------------------------------
# LLM provider (pick one)
# ---------------------------------------------------------------------------

# Mistral API
FLX_LLM_API_KEY=your_mistral_api_key
# FLX_LLM_MODEL=mistral-small-latest   # default: Qwen/Qwen2.5-7B-Instruct-Turbo

# Together AI (also accepted as TOGETHER_API_KEY)
# TOGETHER_API_KEY=your_together_key
# FLX_LLM_BASE_URL=https://api.together.xyz/v1
# FLX_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct-Turbo

# LM Studio (auto-detected at localhost:1234 if no other provider is set)
# FLX_LLM_BASE_URL=http://localhost:1234/v1
# FLX_LLM_MODEL=qwen2.5-7b-instruct

# OpenRouter (accepté aussi comme OPENROUTER_API_KEY)
# OPENROUTER_API_KEY=your_openrouter_key

# ---------------------------------------------------------------------------
# Surcharges de modèle PAR RÔLE (repli sur FLX_LLM_MODEL/_BASE_URL si absent)
# ---------------------------------------------------------------------------

# Pipeline d'ingestion de document (extraction par bloc)
# FLX_LLM_CHECKER_MODEL=
# FLX_LLM_CHECKER_BASE_URL=

# Chatbot (les 3 passes d'extraction + le maître)
# FLX_LLM_CHAT_MODEL=
# FLX_LLM_CHAT_BASE_URL=

# Gate de routage (1 appel court/tour, stateless) — peut tourner sur un modèle
# plus petit que le chat (tiering intra-famille)
# FLX_LLM_GATE_MODEL=
# FLX_LLM_GATE_BASE_URL=

# Vérificateur source (relit le texte source d'une alerte de cohérence pour
# distinguer une vraie incohérence du document d'une mauvaise lecture)
# FLX_LLM_VERIFIER_MODEL=
# FLX_LLM_VERIFIER_BASE_URL=

# ---------------------------------------------------------------------------
# Coût (optionnel)
# ---------------------------------------------------------------------------

# Surcharge de la table de prix par modèle (JSON) — cf. felix.cost.DEFAULT_PRICING
# FLX_PRICING_JSON={"nom-modele": {"input": 0.0, "output": 0.0}}

# ---------------------------------------------------------------------------
# Neo4j (matches docker-compose.yml defaults)
# ---------------------------------------------------------------------------
FLX_NEO4J_URI=bolt://localhost:7687
FLX_NEO4J_USER=neo4j
FLX_NEO4J_PASSWORD=felixpassword   # change this in any shared/prod environment

# ---------------------------------------------------------------------------
# ChromaDB
# ---------------------------------------------------------------------------
FLX_CHROMA_PATH=chroma_data

# Modèle d'embedding du segmenteur (défaut : BAAI/bge-m3)
# FLX_SEGMENTER_EMBEDDING_MODEL=

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# LOGFIRE_TOKEN=your_logfire_token

# Niveau de log (défaut : INFO)
# FLX_LOG_LEVEL=

# ---------------------------------------------------------------------------
# Réglages fins (optionnel — défauts raisonnables dans felix.config)
# ---------------------------------------------------------------------------

# Budget de tokens de l'historique LLM threadé entre tours (défaut : 8000)
# FLX_HISTORY_TOKEN_BUDGET=

# Borne du « working set » injecté aux extracteurs (défaut : 30 entités)
# FLX_RECENT_ENTITIES_LIMIT=

# Human-in-the-loop (#61) : nombre max d'actions manuelles injectées (défaut : 12)
# FLX_USER_EDITS_LIMIT=

# Human-in-the-loop (#61) : TTL en minutes de la consigne « ne recrée pas » (défaut : 240)
# FLX_USER_EDITS_TTL_MINUTES=
